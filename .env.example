# Groq API Key
# Get a free key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# (Optional) Groq Model Selection - defaults to openai/gpt-oss-120b
# Options: openai/gpt-oss-120b, llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL_NAME=openai/gpt-oss-120b

# (Optional) Tavily API key for live web search
# TAVILY_API_KEY=
